{
  "name": "tixu-quiz-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "题序 · 在线刷题平台 Demo（Vue 3 + Fastify + SQLite / PostgreSQL）",
  "scripts": {
    "setup": "node server/setup.js",
    "dev": "concurrently -k -n server,web -c yellow,cyan \"node --watch server/index.js\" \"vite --config vite.config.js\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js",
    "test": "node tests/api.integration.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "adm-zip": "0.5.18",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "katex": "0.16.47",
    "lucide-vue-next": "0.511.0",
    "markdown-it": "14.3.3",
    "pg": "8.16.3",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "concurrently": "9.2.5",
    "vite": "6.4.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true
  }
}
