# ── 服务 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000

# ── 数据库 ──────────────────────────────────────────────
# 默认使用本地 SQLite。若要启用 PostgreSQL，填写 DATABASE_URL；
# 设置后 PostgreSQL 优先，DATABASE_PATH 会被忽略。
# 示例：postgres://tixu:password@127.0.0.1:5432/tixu
# TLS 连接可在 URL 中加入 sslmode=require
DATABASE_URL=
DATABASE_PATH=data/tixu.db
PG_POOL_MAX=10

# 公开分类 / 标签 / 首页统计缓存（秒），0 表示关闭
PUBLIC_CACHE_TTL_SECONDS=10

# 图片与导入资源目录（PostgreSQL 模式下仍使用本地目录）
UPLOAD_DIR=data/uploads

# ── 会话与安全 ──────────────────────────────────────────
SESSION_DAYS=30
COOKIE_SECURE=false

# 仅在首次 setup 时用于创建管理员账户
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ── 上传与导入 ──────────────────────────────────────────
MAX_UPLOAD_MB=5
MAX_IMPORT_MB=15
MAX_IMPORT_UNCOMPRESSED_MB=25

# 额外允许的 CSRF Origin，逗号分隔，必须是 scheme://host[:port]，不要带路径或通配符。
# 例如：ALLOWED_ORIGINS=https://quiz.example.com,https://admin.example.com
ALLOWED_ORIGINS=
# 仅当运行在可信反向代理之后时开启；HTTPS 终止通常需要设为 1 或 true。
TRUST_PROXY=false

LOG_LEVEL=info
